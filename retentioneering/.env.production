# ── GETLOOPX PRODUCTION ENVIRONMENT TEMPLATE ───────────────────
# Database: ClickHouse Cloud
CLICKHOUSE_HOST=f8acr998lg.ap-south-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
CLICKHOUSE_SECURE=true

# Message Queue: RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security
# Generate using: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_64_BYTE_BASE64_STRING
API_KEY=REPLACE_WITH_SECURE_API_KEY

# Infrastructure
PORT=3000
ANALYTICS_PORT=8080
EMAIL_PORT=3001

# AWS SES (for email-service)
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1
