NODE_ENV=staging
APP_ENV=staging
PORT=4001
# Staging DB — separate Postgres database, not production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=getloopx_staging
DB_USER=getloopx_staging_user
DB_PASS=staging_password_change_me
# Staging Redis — same instance, different key prefix is fine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=staging:
# Staging RabbitMQ — same instance, different vhost
RABBITMQ_URL=amqp://localhost/staging
# Stripe TEST mode keys (not live keys)
STRIPE_SECRET_KEY=sk_test_51PXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXX
# Sentry — same DSN, environment tag differentiates it
SENTRY_DSN=https://XXXXXXXXXXXXX@sentry.io/XXXXXXXXXXXXX
# JWT
JWT_SECRET=staging_jwt_secret_XXXXXXXXXXXXX
# Firebase — use same project but a separate test user pool if possible
FIREBASE_SERVICE_ACCOUNT=./config/firebase-staging.json
# AWS SES — use sandbox mode for staging
AWS_SES_REGION=ap-south-1
SES_FROM_EMAIL=staging@getloopx.com
