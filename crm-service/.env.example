PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/dbname
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
NODE_ENV=development
SKIP_AUTH=true

# AWS Configuration (Get these from the project lead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
SES_FROM_EMAIL=no-reply@yourdomain.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ecosystem
APP_BASE_URL=http://localhost:4000
INGESTION_SERVICE_URL=http://localhost:3000
ANALYTICS_SERVICE_URL=http://localhost:8081
INGESTION_API_KEY=your-api-key
CRM_ORG_ID=crm-system
